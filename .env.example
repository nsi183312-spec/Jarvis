# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ELEVENLABS_API_KEY: Optional server-side neural TTS voice API key.
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# OLLAMA_API_KEY: Server-side Ollama Cloud AI Brain API key (https://ollama.com/api).
OLLAMA_API_KEY="MY_OLLAMA_API_KEY"
OLLAMA_MODEL="glm-5.3-flash"
